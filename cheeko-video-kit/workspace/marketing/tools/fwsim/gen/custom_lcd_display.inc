    dl_pct_.store(file_percent, std::memory_order_relaxed);
    // Release last: the timer reads this first, so the name/counters above are
    // guaranteed visible once it sees the flag.
    dl_active_.store(true, std::memory_order_release);
  }

  // Called from the download task when the download ends (success or failure).
  void EndDownloadProgress() {
    dl_active_.store(false, std::memory_order_release);
  }

  // Runs on the LVGL task from dl_timer_, so the lock is already held.
  //
  // `file_percent` is how far through the CURRENT file we are (0-100), so the
  // bar advances smoothly inside one large file instead of standing still.
  // The overall figure blends it into the file counter: a pack of 4 files
  // sitting halfway through file 2 reads 37%, not a frozen 25%.
  void ShowDownloadProgressLocked(const char *skill_name, int current,
                                  int total, int file_percent) {
    if (dl_overlay_ == nullptr) {
      return;
    }
    char buf[64];
    snprintf(buf, sizeof(buf), "Getting %s ready...", skill_name);
    lv_label_set_text(dl_label_, buf);

    // `current` is 1-based and means "file N is in flight", so N-1 are done.
    int pct = 0;
    if (total > 0) {
      const int done = (current > 0) ? current - 1 : 0;
      if (file_percent < 0) file_percent = 0;
      if (file_percent > 100) file_percent = 100;
      pct = (done * 100 + file_percent) / total;
      if (pct > 100) pct = 100;
    }
    lv_bar_set_value(dl_bar_, pct, LV_ANIM_OFF);

    snprintf(buf, sizeof(buf), "%d%%   file %d of %d", pct,
             current > 0 ? current : 1, total > 0 ? total : 1);
    lv_label_set_text(dl_count_, buf);

    // Only raise the overlay when it is not already up. move_foreground()
    // reorders siblings and invalidates the whole area, so doing it on every
    // progress tick is pure cost.
    if (lv_obj_has_flag(dl_overlay_, LV_OBJ_FLAG_HIDDEN)) {
      lv_obj_remove_flag(dl_overlay_, LV_OBJ_FLAG_HIDDEN);
      lv_obj_move_foreground(dl_overlay_);
    }
  }

  // Hide download overlay
  void HideDownloadProgress() {
    // Stop the refresh timer re-showing the overlay on its next tick. Clear
    // this BEFORE hiding, or a tick landing in between puts it straight back.
    EndDownloadProgress();
    DisplayLockGuard lock(this);
    if (dl_overlay_ != nullptr) {
      lv_obj_add_flag(dl_overlay_, LV_OBJ_FLAG_HIDDEN);
    }
  }

  // What the child just placed on the reader. The names are what appears on
  // the reveal card, so they are deliberately one short word each - three very
  // different sounds a four-year-old can tell apart before they can read them.
  // Reveal timing. Deliberately unhurried: the point is that the child gets to
  // SEE what they placed before anything starts, so the hold is long enough to
  // read the word rather than just register a flash.
  static constexpr uint32_t kCardRevealInMs = 320;
  static constexpr uint32_t kCardRevealHoldMs = 900;
  static constexpr uint32_t kCardRevealOutMs = 280;
  // The name fades in after the card lands, inside the hold.
  static constexpr uint32_t kCardRevealNameMs = 220;
  // What a caller waits before starting playback. Stops just short of the full
  // animation so the first audio lands as the card slides away, rather than
  // after a beat of dead screen.
  static constexpr uint32_t kCardRevealTotalMs =
      kCardRevealInMs + kCardRevealHoldMs + kCardRevealOutMs / 2;

  enum class CardKind {
    kDiscover,  // content: stories, rhymes, phonics, slokas
    kHello,   // an AI character comes to talk
    kQuest,   // a game
  };

  struct CardKindStyle {
    const char *label;
    uint32_t accent;
  };

  static const CardKindStyle &StyleForCardKind(CardKind kind) {
    // Amber / violet / green. Chosen to differ in BRIGHTNESS as well as hue, so
    // they stay tellable apart for the most common colour blindness and at the
    // low brightness the toy dims to indoors.
    static constexpr CardKindStyle kDiscover{"Discover", 0xF5A623};
    static constexpr CardKindStyle kHello{"Hello", 0x8B5CF6};
    static constexpr CardKindStyle kQuest{"Quest", 0x22C55E};
    switch (kind) {
      case CardKind::kHello:
        return kHello;
      case CardKind::kQuest:
        return kQuest;
      default:
        return kDiscover;
    }
  }

  // Announces the card, then gets out of the way. Returns immediately - the
  // animation runs on the LVGL timer, and the caller waits kCardRevealTotalMs
  // on its own task before starting playback.
  void ShowCardReveal(CardKind kind, const char *name) {
    DisplayLockGuard lock(this);
    if (card_reveal_overlay_ == nullptr || card_reveal_panel_ == nullptr) {
      return;
    }
    const CardKindStyle &style = StyleForCardKind(kind);
    const lv_color_t accent = lv_color_hex(style.accent);
    lv_obj_set_style_bg_color(card_reveal_panel_, accent, 0);
    lv_obj_set_style_border_color(card_reveal_panel_, lv_color_white(), 0);
    lv_obj_set_style_shadow_color(card_reveal_panel_, accent, 0);
    lv_label_set_text(card_reveal_type_, style.label);

    card_reveal_has_name_ = (name != nullptr && name[0] != '\0');
    if (card_reveal_has_name_) {
      lv_label_set_text(card_reveal_name_, name);
      lv_obj_align(card_reveal_type_, LV_ALIGN_CENTER, 0, -14);
      // Transparent, not hidden: it fades in once the card has landed, so the
      // arrival and the naming are two separate beats.
      lv_obj_set_style_opa(card_reveal_name_, LV_OPA_TRANSP, 0);
      lv_obj_remove_flag(card_reveal_name_, LV_OBJ_FLAG_HIDDEN);
    } else {
      // No name to show (content packs downloaded before names were stored).
      // Centre the type word rather than leaving a gap under it.
      lv_obj_add_flag(card_reveal_name_, LV_OBJ_FLAG_HIDDEN);
      lv_obj_align(card_reveal_type_, LV_ALIGN_CENTER, 0, 0);
    }

    lv_obj_remove_flag(card_reveal_overlay_, LV_OBJ_FLAG_HIDDEN);
    lv_obj_move_foreground(card_reveal_overlay_);

    lv_anim_delete(card_reveal_panel_, nullptr);  // restart cleanly on a re-tap
    lv_anim_t a;
    lv_anim_init(&a);
    lv_anim_set_var(&a, card_reveal_panel_);
    lv_anim_set_exec_cb(&a, CardRevealInExec);
    lv_anim_set_values(&a, 0, 256);
    lv_anim_set_duration(&a, kCardRevealInMs);
    // Ease-out, not overshoot: a bounce would read as the card being dropped
    // ON something. Decelerating into place reads as being drawn IN.
    lv_anim_set_path_cb(&a, lv_anim_path_ease_out);
    lv_anim_set_user_data(&a, this);
    lv_anim_set_completed_cb(&a, [](lv_anim_t *anim) {
      auto *self = static_cast<CustomLcdDisplay *>(lv_anim_get_user_data(anim));
      self->StartCardRevealNameFade();
    });
    lv_anim_start(&a);

    if (card_reveal_hold_timer_ != nullptr) {
      lv_timer_reset(card_reveal_hold_timer_);
      lv_timer_resume(card_reveal_hold_timer_);
    }
  }

  void ShowCardFeedback(const char *message, bool is_error = true) {
    DisplayLockGuard lock(this);
    if (card_feedback_overlay_ == nullptr || card_feedback_timer_ == nullptr) {
      return;
    }

    const auto &theme = CheekoTheme::Current();
    lv_obj_set_style_bg_color(card_feedback_panel_, theme.colors.menu_card, 0);
    lv_obj_set_style_border_color(card_feedback_panel_,
                                  theme.colors.menu_hairline, 0);
    lv_obj_set_style_bg_color(card_feedback_symbol_,
                              is_error ? theme.colors.danger
                                       : theme.colors.warning,
                              0);
    lv_obj_set_style_text_color(card_feedback_label_,
                                theme.colors.menu_text_primary, 0);
    lv_label_set_text(card_feedback_label_, message != nullptr ? message : "");
    lv_obj_remove_flag(card_feedback_overlay_, LV_OBJ_FLAG_HIDDEN);
    lv_obj_move_foreground(card_feedback_overlay_);
    lv_timer_reset(card_feedback_timer_);
    lv_timer_resume(card_feedback_timer_);
  }

  void HideCardFeedback() {
    DisplayLockGuard lock(this);
    HideCardFeedbackLocked();
  }

  // Full-screen image: COVER mode fills entire screen
  void SetPreviewImage(std::unique_ptr<LvglImage> image) override {
    DisplayLockGuard lock(this);
    if (preview_image_ == nullptr) {
      return;
    }

    if (image == nullptr) {
      esp_timer_stop(preview_timer_);
      lv_obj_add_flag(preview_image_, LV_OBJ_FLAG_HIDDEN);
      lv_obj_set_size(preview_image_, width_ / 2, height_ / 2);
      lv_obj_align(preview_image_, LV_ALIGN_CENTER, 0, 0);
      preview_image_cached_.reset();
      return;
    }

    preview_image_cached_ = std::move(image);
    auto img_dsc = preview_image_cached_->image_dsc();

    // Full screen size
    lv_obj_set_size(preview_image_, width_, height_);
    lv_obj_align(preview_image_, LV_ALIGN_CENTER, 0, 0);

    lv_image_set_src(preview_image_, img_dsc);
    lv_image_set_inner_align(preview_image_, LV_IMAGE_ALIGN_COVER);
    lv_image_set_antialias(preview_image_, false);

    lv_obj_remove_flag(preview_image_, LV_OBJ_FLAG_HIDDEN);
    lv_obj_move_foreground(preview_image_);
  }

private:
  enum class FutureFaceMode {
    kNormal,
    kListen,
    kThinking,
    kSpeaking,
    kSleep,
    kHappy,
  };

  struct FutureFaceWidgets {
    lv_obj_t *root = nullptr;
    lv_obj_t *halo = nullptr;
    lv_obj_t *left_brow = nullptr;
    lv_obj_t *right_brow = nullptr;
    lv_obj_t *left_eye = nullptr;
    lv_obj_t *right_eye = nullptr;
    lv_obj_t *mouth[3] = {};
  };

  std::function<void()> on_status_observed_;  // see SetOnStatusObserved()
  lv_obj_t *dl_overlay_ = nullptr;
  lv_obj_t *dl_label_ = nullptr;
  lv_obj_t *dl_bar_ = nullptr;
  lv_obj_t *dl_count_ = nullptr;

  // Download progress is produced by the "card_dl" task and consumed by an
  // LVGL timer, never the other way round. The download task ONLY does atomic
  // stores here: it must not touch LVGL or take the display lock. An earlier
  // version called ShowDownloadProgress() straight from the download loop, and
  // because DisplayLockGuard waits up to 30 s on the one mutex the whole UI
  // serialises on, the download task spent its time fighting the LVGL task for
  // that lock - 69% CPU, ~1% of it actually receiving, and a 2.87 MB download
  // that took 36 s before had not finished after three minutes.
  std::atomic<int> dl_cur_{0};
  std::atomic<int> dl_total_{0};
  std::atomic<int> dl_pct_{0};
  std::atomic<bool> dl_active_{false};
  char dl_name_[32] = {0};
  lv_timer_t *dl_timer_ = nullptr;
  // Last values actually painted, so an unchanged tick costs nothing.
  int dl_drawn_cur_ = -1;
  int dl_drawn_total_ = -1;
  int dl_drawn_pct_ = -1;
  bool dl_shown_ = false;
  // Card reveal: the little animated card that names what was just tapped.
  lv_obj_t *card_reveal_overlay_ = nullptr;
  lv_obj_t *card_reveal_panel_ = nullptr;
  lv_obj_t *card_reveal_type_ = nullptr;
  lv_obj_t *card_reveal_name_ = nullptr;
  lv_timer_t *card_reveal_hold_timer_ = nullptr;
  bool card_reveal_has_name_ = false;

  lv_obj_t *card_feedback_overlay_ = nullptr;
  lv_obj_t *card_feedback_panel_ = nullptr;
  lv_obj_t *card_feedback_symbol_ = nullptr;
  lv_obj_t *card_feedback_label_ = nullptr;
  lv_timer_t *card_feedback_timer_ = nullptr;
  std::unique_ptr<CheekoOs> cheeko_os_;
  std::function<void(ImagineCue)> imagine_cue_;  // AI Imagine sound+haptic cues
  std::string imagine_cue_stage_;                // last cued stage (dedupe)
  CheekoVoiceChanger voice_changer_;  // Funny Voice engine (owned by the display)
  FutureFaceWidgets idle_face_;
  FutureFaceWidgets chat_face_;
  lv_timer_t *future_face_timer_ = nullptr;
  FutureFaceMode future_face_mode_ = FutureFaceMode::kNormal;
  uint8_t future_face_frame_ = 0;

  void HideCardFeedbackLocked() {
    if (card_feedback_overlay_ != nullptr) {
      lv_obj_add_flag(card_feedback_overlay_, LV_OBJ_FLAG_HIDDEN);
    }
    if (card_feedback_timer_ != nullptr) {
      lv_timer_pause(card_feedback_timer_);
    }
  }

  void CreateDownloadOverlay() {
    DisplayLockGuard lock(this);
    dl_overlay_ = lv_obj_create(lv_screen_active());
    lv_obj_set_size(dl_overlay_, width_, height_);
    lv_obj_align(dl_overlay_, LV_ALIGN_CENTER, 0, 0);
    lv_obj_set_style_bg_color(dl_overlay_, lv_color_black(), 0);
    lv_obj_set_style_bg_opa(dl_overlay_, LV_OPA_70, 0);
    lv_obj_set_style_border_width(dl_overlay_, 0, 0);
    lv_obj_set_style_radius(dl_overlay_, 0, 0);
    lv_obj_remove_flag(dl_overlay_, LV_OBJ_FLAG_SCROLLABLE);

    // "Downloading Brush..."
    dl_label_ = lv_label_create(dl_overlay_);
    lv_obj_set_style_text_color(dl_label_, lv_color_white(), 0);
    lv_label_set_text(dl_label_, "");
    lv_obj_align(dl_label_, LV_ALIGN_CENTER, 0, -30);

    // Progress bar (160px wide, 10px tall)
    dl_bar_ = lv_bar_create(dl_overlay_);
    lv_obj_set_size(dl_bar_, 160, 10);
    lv_obj_align(dl_bar_, LV_ALIGN_CENTER, 0, 0);
    lv_bar_set_range(dl_bar_, 0, 100);
    lv_bar_set_value(dl_bar_, 0, LV_ANIM_OFF);

    // "3 / 10"
    dl_count_ = lv_label_create(dl_overlay_);
    lv_obj_set_style_text_color(dl_count_, lv_color_white(), 0);
    lv_label_set_text(dl_count_, "");
    lv_obj_align(dl_count_, LV_ALIGN_CENTER, 0, 20);

    // Hidden by default
    lv_obj_add_flag(dl_overlay_, LV_OBJ_FLAG_HIDDEN);
  }

  // How far above and below centre the card travels, in pixels. Far enough to
  // start and finish fully off the panel, so it reads as entering and leaving
  // rather than fading on the spot.
  static constexpr int32_t kRevealTravelPx = 170;

  // Enters from ABOVE, travelling down - the same direction the child's hand
  // moves when they place the card on the reader. Paired with an ease-out path
  // it feels like the card is being drawn INTO the toy, the way a slip feeds
  // into a printer, instead of a panel appearing out of nowhere.
  static void CardRevealInExec(void *var, int32_t v) {
    auto *obj = static_cast<lv_obj_t *>(var);
    const int32_t remaining = 256 - v;  // 256 -> 0 as it settles at centre
    lv_obj_set_style_translate_x(obj, 0, 0);
    lv_obj_set_style_translate_y(obj, (-kRevealTravelPx * remaining) / 256, 0);
    lv_obj_set_style_opa(obj, (lv_opa_t)(v > 255 ? 255 : v), 0);
  }

  // Leaves DOWNWARD, continuing the same travel - swallowed by the toy rather
  // than reversing back out the way it came.
  static void CardRevealOutExec(void *var, int32_t v) {
    auto *obj = static_cast<lv_obj_t *>(var);
    const int32_t travelled = 256 - v;  // 0 -> 256 as it disappears
    lv_obj_set_style_translate_x(obj, 0, 0);
    lv_obj_set_style_translate_y(obj, (kRevealTravelPx * travelled) / 256, 0);
    lv_obj_set_style_opa(obj, (lv_opa_t)(v > 255 ? 255 : v), 0);
  }

  // Fades the name in once the card has settled, so the two beats read in
  // order: the card arrives, THEN it tells you what it is.
  static void CardRevealNameExec(void *var, int32_t v) {
    lv_obj_set_style_opa(static_cast<lv_obj_t *>(var),
                         (lv_opa_t)(v > 255 ? 255 : v), 0);
  }

  void CreateCardRevealOverlay() {
    DisplayLockGuard lock(this);
    card_reveal_overlay_ = lv_obj_create(lv_screen_active());
    lv_obj_set_size(card_reveal_overlay_, width_, height_);
    lv_obj_center(card_reveal_overlay_);
    lv_obj_set_style_bg_color(card_reveal_overlay_, lv_color_black(), 0);
    lv_obj_set_style_bg_opa(card_reveal_overlay_, LV_OPA_50, 0);
    lv_obj_set_style_border_width(card_reveal_overlay_, 0, 0);
    lv_obj_set_style_radius(card_reveal_overlay_, 0, 0);
    lv_obj_set_style_pad_all(card_reveal_overlay_, 0, 0);
    lv_obj_clear_flag(card_reveal_overlay_, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_flag(card_reveal_overlay_, LV_OBJ_FLAG_HIDDEN);

    // Same 196-wide budget the feedback panel uses, so it clears the rounded
    // corners of the display at every angle.
    card_reveal_panel_ = lv_obj_create(card_reveal_overlay_);
    lv_obj_set_size(card_reveal_panel_, 196, 124);
    lv_obj_center(card_reveal_panel_);
    lv_obj_set_style_radius(card_reveal_panel_, 18, 0);
    lv_obj_set_style_border_width(card_reveal_panel_, 2, 0);
    lv_obj_set_style_shadow_width(card_reveal_panel_, 18, 0);
    lv_obj_set_style_shadow_opa(card_reveal_panel_, LV_OPA_30, 0);
    lv_obj_set_style_pad_all(card_reveal_panel_, 0, 0);
    lv_obj_clear_flag(card_reveal_panel_, LV_OBJ_FLAG_SCROLLABLE);

    card_reveal_type_ = lv_label_create(card_reveal_panel_);
    // Bounded to the panel's inner width: "Discover" is half again as long as
    // "Hello", and an unbounded label would run past the rounded corners.
    lv_obj_set_width(card_reveal_type_, 176);
    lv_obj_set_style_text_align(card_reveal_type_, LV_TEXT_ALIGN_CENTER, 0);
    lv_label_set_long_mode(card_reveal_type_, LV_LABEL_LONG_DOT);
    lv_obj_set_style_text_font(card_reveal_type_,
                               CheekoTheme::Current().fonts.title, 0);
    lv_obj_set_style_text_color(card_reveal_type_, lv_color_white(), 0);
    lv_obj_align(card_reveal_type_, LV_ALIGN_CENTER, 0, -14);

    card_reveal_name_ = lv_label_create(card_reveal_panel_);
    lv_obj_set_width(card_reveal_name_, 172);
    lv_obj_set_style_text_font(card_reveal_name_,
                               CheekoTheme::Current().fonts.caption, 0);
    lv_obj_set_style_text_color(card_reveal_name_, lv_color_white(), 0);
    lv_obj_set_style_text_align(card_reveal_name_, LV_TEXT_ALIGN_CENTER, 0);
    lv_label_set_long_mode(card_reveal_name_, LV_LABEL_LONG_DOT);
    lv_obj_align(card_reveal_name_, LV_ALIGN_CENTER, 0, 22);

    // Paused; ShowCardReveal resets and resumes it so the hold starts when the
    // card has actually finished sliding in.
    card_reveal_hold_timer_ = lv_timer_create(
        [](lv_timer_t *timer) {
          auto *self = static_cast<CustomLcdDisplay *>(lv_timer_get_user_data(timer));
          lv_timer_pause(timer);
          self->StartCardRevealExit();
        },
        kCardRevealInMs + kCardRevealHoldMs, this);
    lv_timer_pause(card_reveal_hold_timer_);
  }

  void StartCardRevealNameFade() {
    if (!card_reveal_has_name_ || card_reveal_name_ == nullptr) {
      return;
    }
    lv_anim_t a;
    lv_anim_init(&a);
    lv_anim_set_var(&a, card_reveal_name_);
    lv_anim_set_exec_cb(&a, CardRevealNameExec);
    lv_anim_set_values(&a, 0, 256);
    lv_anim_set_duration(&a, kCardRevealNameMs);
    lv_anim_set_path_cb(&a, lv_anim_path_ease_out);
    lv_anim_start(&a);
  }

  void StartCardRevealExit() {
    if (card_reveal_panel_ == nullptr) {
      return;
    }
    lv_anim_t a;
    lv_anim_init(&a);
    lv_anim_set_var(&a, card_reveal_panel_);
    lv_anim_set_exec_cb(&a, CardRevealOutExec);
    lv_anim_set_values(&a, 256, 0);
    lv_anim_set_duration(&a, kCardRevealOutMs);
    lv_anim_set_path_cb(&a, lv_anim_path_ease_in);
    lv_anim_set_user_data(&a, this);
    lv_anim_set_completed_cb(&a, [](lv_anim_t *anim) {
      auto *self = static_cast<CustomLcdDisplay *>(lv_anim_get_user_data(anim));
      if (self->card_reveal_overlay_ != nullptr) {
        lv_obj_add_flag(self->card_reveal_overlay_, LV_OBJ_FLAG_HIDDEN);
      }
    });
    lv_anim_start(&a);
  }

  void CreateCardFeedbackOverlay() {
    DisplayLockGuard lock(this);
    card_feedback_overlay_ = lv_obj_create(lv_screen_active());
    lv_obj_set_size(card_feedback_overlay_, width_, height_);
    lv_obj_center(card_feedback_overlay_);
    lv_obj_set_style_bg_color(card_feedback_overlay_, lv_color_black(), 0);
    lv_obj_set_style_bg_opa(card_feedback_overlay_, LV_OPA_40, 0);
    lv_obj_set_style_border_width(card_feedback_overlay_, 0, 0);
    lv_obj_set_style_radius(card_feedback_overlay_, 0, 0);
    lv_obj_set_style_pad_all(card_feedback_overlay_, 0, 0);
    lv_obj_clear_flag(card_feedback_overlay_, LV_OBJ_FLAG_SCROLLABLE);

    // A centered 196x132 panel stays inside the capsule at every corner.
    card_feedback_panel_ = lv_obj_create(card_feedback_overlay_);
    lv_obj_set_size(card_feedback_panel_, 196, 132);
    lv_obj_center(card_feedback_panel_);
    lv_obj_set_style_radius(card_feedback_panel_, 16, 0);
    lv_obj_set_style_border_width(card_feedback_panel_, 1, 0);
    lv_obj_set_style_shadow_width(card_feedback_panel_, 12, 0);
    lv_obj_set_style_shadow_opa(card_feedback_panel_, LV_OPA_20, 0);
    lv_obj_set_style_pad_all(card_feedback_panel_, 0, 0);
    lv_obj_clear_flag(card_feedback_panel_, LV_OBJ_FLAG_SCROLLABLE);

    card_feedback_symbol_ = lv_obj_create(card_feedback_panel_);
    lv_obj_set_size(card_feedback_symbol_, 48, 48);
    lv_obj_align(card_feedback_symbol_, LV_ALIGN_TOP_MID, 0, 16);
    lv_obj_set_style_radius(card_feedback_symbol_, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_border_width(card_feedback_symbol_, 0, 0);
    lv_obj_set_style_pad_all(card_feedback_symbol_, 0, 0);
    lv_obj_clear_flag(card_feedback_symbol_, LV_OBJ_FLAG_SCROLLABLE);

    lv_obj_t *mark = lv_label_create(card_feedback_symbol_);
    lv_obj_set_style_text_font(mark, CheekoTheme::Current().fonts.title, 0);
    lv_obj_set_style_text_color(mark, lv_color_white(), 0);
    lv_label_set_text(mark, "!");
    lv_obj_center(mark);

    card_feedback_label_ = lv_label_create(card_feedback_panel_);
    lv_obj_set_width(card_feedback_label_, 172);
    lv_obj_set_style_text_font(card_feedback_label_,
                               CheekoTheme::Current().fonts.caption, 0);
    lv_obj_set_style_text_align(card_feedback_label_, LV_TEXT_ALIGN_CENTER, 0);
    lv_label_set_long_mode(card_feedback_label_, LV_LABEL_LONG_WRAP);
    lv_obj_align(card_feedback_label_, LV_ALIGN_BOTTOM_MID, 0, -18);

    card_feedback_timer_ = lv_timer_create(
        [](lv_timer_t *timer) {
          auto *self =
              static_cast<CustomLcdDisplay *>(lv_timer_get_user_data(timer));
          if (self != nullptr) {
            self->HideCardFeedbackLocked();
          } else {
            lv_timer_pause(timer);
          }
        },
        2000, this);
    lv_timer_pause(card_feedback_timer_);
    lv_obj_add_flag(card_feedback_overlay_, LV_OBJ_FLAG_HIDDEN);

    // Drives the download overlay from the LVGL task. Deliberately NOT
    // paused/resumed: lv_timer_pause/resume would have to be called from the
    // download task, which is the very cross-task LVGL access this design
    // exists to avoid. Four no-op wakeups a second is cheaper than that risk.
    dl_timer_ = lv_timer_create(
        [](lv_timer_t *timer) {
          auto *self =
              static_cast<CustomLcdDisplay *>(lv_timer_get_user_data(timer));
          if (self == nullptr) {
            return;
          }
          self->RefreshDownloadProgressLocked();
        },
        250, this);
  }

  // LVGL task, lock already held.
  //
  // Redraws ONLY when a displayed value actually changed. The first version
  // rewrote both labels, set the bar and called lv_obj_move_foreground() every
  // single tick - four full-screen invalidations a second whether anything had
  // moved or not. On a 296x240 panel that is real work for no visible
  // difference, and it showed up as taskLVGL climbing from ~5% to 12% during
  // downloads.
  void RefreshDownloadProgressLocked() {
    if (!dl_active_.load(std::memory_order_acquire)) {
      dl_shown_ = false;
      return;
    }
    const int cur = dl_cur_.load(std::memory_order_relaxed);
    const int total = dl_total_.load(std::memory_order_relaxed);
    const int pct = dl_pct_.load(std::memory_order_relaxed);
    if (dl_shown_ && cur == dl_drawn_cur_ && total == dl_drawn_total_ &&
        pct == dl_drawn_pct_) {
      return;
    }
    dl_drawn_cur_ = cur;
    dl_drawn_total_ = total;
    dl_drawn_pct_ = pct;
    ShowDownloadProgressLocked(dl_name_, cur, total, pct);
    dl_shown_ = true;
  }

  void CustomizeLayout() {
    DisplayLockGuard lock(this);
    // Rectangular 296x240 landscape display with rounded corners.
    // Top bar padding already set to 36px in SetupUI — no further adjustments.
  }

  void CreateFutureFace() {
    DisplayLockGuard lock(this);
    CreateFutureFaceWidgets(chat_activity_box_, chat_face_, 112, 74);
    if (chat_face_.root != nullptr) {
      lv_obj_center(chat_face_.root);
      lv_obj_add_flag(chat_face_.root, LV_OBJ_FLAG_HIDDEN);
    }

    // Only animate if a face actually exists. After the Gotchi refactor the
    // base chat_activity_box_ is permanently nullptr, so CreateFutureFaceWidgets
    // early-returns and chat_face_.root/idle_face_.root stay null — without this
    // guard the timer would fire every 120ms forever doing nothing.
    if (chat_face_.root == nullptr && idle_face_.root == nullptr) {
      return;
    }

    future_face_timer_ = lv_timer_create(
        [](lv_timer_t *timer) {
          auto *self =
              static_cast<CustomLcdDisplay *>(lv_timer_get_user_data(timer));
          if (self != nullptr) {
            self->AdvanceFutureFaceFrame();
          }
        },
        120, this);
  }

  void CreateFutureFaceWidgets(lv_obj_t *parent, FutureFaceWidgets &face,
                               int width, int height) {
    if (parent == nullptr) {
      return;
    }

    face.root = lv_obj_create(parent);
    lv_obj_set_size(face.root, width, height);
    lv_obj_set_style_bg_color(face.root, lv_color_hex(0x050708), 0);
    lv_obj_set_style_bg_opa(face.root, LV_OPA_90, 0);
    lv_obj_set_style_border_color(face.root, lv_color_hex(0x202729), 0);
    lv_obj_set_style_border_width(face.root, 2, 0);
    lv_obj_set_style_radius(face.root, height / 2, 0);
    lv_obj_set_style_pad_all(face.root, 0, 0);
    lv_obj_clear_flag(face.root, LV_OBJ_FLAG_SCROLLABLE);

    face.halo = lv_obj_create(face.root);
    lv_obj_set_size(face.halo, width - 18, height - 18);
    lv_obj_center(face.halo);
    lv_obj_set_style_radius(face.halo, (height - 18) / 2, 0);
    lv_obj_set_style_bg_color(face.halo, lv_color_hex(0x10262A), 0);
    lv_obj_set_style_bg_opa(face.halo, LV_OPA_40, 0);
    lv_obj_set_style_border_width(face.halo, 0, 0);
    lv_obj_clear_flag(face.halo, LV_OBJ_FLAG_SCROLLABLE);

    face.left_brow = CreateFutureFacePart(face.root, width / 4, 6,
                                          lv_color_hex(0xE7FF3B), 3);
    face.right_brow = CreateFutureFacePart(face.root, width / 4, 6,
                                           lv_color_hex(0xE7FF3B), 3);
    face.left_eye = CreateFutureFacePart(face.root, width / 5, height / 4,
                                         lv_color_hex(0x22D9FF), 7);
    face.right_eye = CreateFutureFacePart(face.root, width / 5, height / 4,
                                          lv_color_hex(0x22D9FF), 7);

    for (int i = 0; i < 3; ++i) {
      face.mouth[i] = CreateFutureFacePart(face.root, width / 12, 8,
                                           lv_color_hex(0xFD7C21), 4);
    }
  }

  lv_obj_t *CreateFutureFacePart(lv_obj_t *parent, int width, int height,
                                 lv_color_t color, int radius) {
    lv_obj_t *part = lv_obj_create(parent);
    lv_obj_set_size(part, width, height);
    lv_obj_set_style_bg_color(part, color, 0);
    lv_obj_set_style_bg_opa(part, LV_OPA_COVER, 0);
    lv_obj_set_style_border_width(part, 0, 0);
    lv_obj_set_style_radius(part, radius, 0);
    lv_obj_set_style_pad_all(part, 0, 0);
    lv_obj_clear_flag(part, LV_OBJ_FLAG_SCROLLABLE);
    return part;
  }

  void SetFutureFaceMode(FutureFaceMode mode) {
    DisplayLockGuard lock(this);
    future_face_mode_ = mode;
    future_face_frame_ = 0;
    UpdateFutureFaceVisibility();
    ApplyFutureFaceFrame(idle_face_);
    ApplyFutureFaceFrame(chat_face_);
  }

  void AdvanceFutureFaceFrame() {
    DisplayLockGuard lock(this);
    future_face_frame_++;
    UpdateFutureFaceVisibility();
    ApplyFutureFaceFrame(idle_face_);
    ApplyFutureFaceFrame(chat_face_);
  }

  void UpdateFutureFaceVisibility() {
    if (idle_face_.root != nullptr) {
      lv_obj_add_flag(idle_face_.root, LV_OBJ_FLAG_HIDDEN);
    }
    if (idle_logo_ != nullptr) {
      lv_obj_add_flag(idle_logo_, LV_OBJ_FLAG_HIDDEN);
    }

    const bool chat_visible = future_face_mode_ != FutureFaceMode::kNormal &&
                              future_face_mode_ != FutureFaceMode::kSleep;
    if (chat_face_.root != nullptr) {
      if (chat_visible) {
        lv_obj_remove_flag(chat_face_.root, LV_OBJ_FLAG_HIDDEN);
        lv_obj_move_foreground(chat_face_.root);
      } else {
        lv_obj_add_flag(chat_face_.root, LV_OBJ_FLAG_HIDDEN);
      }
    }
    if (chat_stage_label_ != nullptr && chat_hint_label_ != nullptr) {
      if (chat_visible) {
        lv_obj_add_flag(chat_stage_label_, LV_OBJ_FLAG_HIDDEN);
        lv_obj_add_flag(chat_hint_label_, LV_OBJ_FLAG_HIDDEN);
      } else {
        lv_obj_remove_flag(chat_stage_label_, LV_OBJ_FLAG_HIDDEN);
        lv_obj_remove_flag(chat_hint_label_, LV_OBJ_FLAG_HIDDEN);
      }
    }
  }

  void ApplyFutureFaceFrame(FutureFaceWidgets &face) {
    if (face.root == nullptr) {
      return;
    }

    int root_width = lv_obj_get_width(face.root);
    int root_height = lv_obj_get_height(face.root);
    int pulse = future_face_frame_ % 10;
    int bounce = pulse < 5 ? pulse : 10 - pulse;
    int eye_height = root_height / 4;
    int eye_width = root_width / 5;
    int eye_y = root_height / 2 - eye_height / 2;
    int eye_dx = 0;
    int mouth_base_y = root_height * 3 / 4;
    lv_color_t eye_color = lv_color_hex(0x22D9FF);
    lv_color_t brow_color = lv_color_hex(0xE7FF3B);
    lv_color_t mouth_color = lv_color_hex(0xFD7C21);
    lv_opa_t halo_opa = LV_OPA_40;

    switch (future_face_mode_) {
    case FutureFaceMode::kListen:
      eye_width += bounce;
      eye_height += bounce / 2;
      eye_dx = (future_face_frame_ % 6) - 3;
      halo_opa = static_cast<lv_opa_t>(LV_OPA_40 + bounce * 8);
      break;
    case FutureFaceMode::kThinking:
      eye_width -= 3;
      eye_height = root_height / 5;
      eye_dx = (future_face_frame_ % 12) < 6 ? -4 : 4;
      brow_color = lv_color_hex(0x7CFFB2);
      mouth_color = lv_color_hex(0x7CFFB2);
      halo_opa = LV_OPA_50;
      break;
    case FutureFaceMode::kSpeaking:
      eye_height += 2;
      eye_color = lv_color_hex(0x42F5FF);
      halo_opa = static_cast<lv_opa_t>(LV_OPA_50 + bounce * 7);
      break;
    case FutureFaceMode::kSleep:
      eye_height = 5;
      eye_width += 8;
      brow_color = lv_color_hex(0x536066);
      eye_color = lv_color_hex(0x536066);
      mouth_color = lv_color_hex(0x536066);
      halo_opa = LV_OPA_20;
      break;
    case FutureFaceMode::kHappy:
      eye_width += 5;
      eye_height += bounce;
      eye_y -= 2;
      brow_color = lv_color_hex(0xE7FF3B);
      mouth_color = lv_color_hex(0xE7FF3B);
      halo_opa = static_cast<lv_opa_t>(LV_OPA_50 + bounce * 6);
      break;
    case FutureFaceMode::kNormal:
      if (future_face_frame_ % 34 >= 29) {
        eye_height = 5;
        eye_width += 5;
      }
      break;
    }

    lv_obj_set_style_bg_opa(face.halo, halo_opa, 0);
    lv_obj_set_style_bg_color(face.left_eye, eye_color, 0);
    lv_obj_set_style_bg_color(face.right_eye, eye_color, 0);
    lv_obj_set_style_bg_color(face.left_brow, brow_color, 0);
    lv_obj_set_style_bg_color(face.right_brow, brow_color, 0);

    lv_obj_set_size(face.left_eye, eye_width, eye_height);
    lv_obj_set_size(face.right_eye, eye_width, eye_height);
    lv_obj_set_pos(face.left_eye, root_width / 2 - eye_width - 8 + eye_dx,
                   eye_y);
    lv_obj_set_pos(face.right_eye, root_width / 2 + 8 + eye_dx, eye_y);

    int brow_y = eye_y - 14;
    int brow_width = root_width / 4;
    lv_obj_set_size(face.left_brow, brow_width, 6);
    lv_obj_set_size(face.right_brow, brow_width, 6);
    int left_brow_y =
        brow_y + (future_face_mode_ == FutureFaceMode::kHappy ? 3 : 0);
    int right_brow_y =
        brow_y + (future_face_mode_ == FutureFaceMode::kThinking ? 4 : 0);
    lv_obj_set_pos(face.left_brow, root_width / 2 - brow_width - 10 + eye_dx,
                   left_brow_y);
    lv_obj_set_pos(face.right_brow, root_width / 2 + 10 + eye_dx,
                   right_brow_y);

    for (int i = 0; i < 3; ++i) {
      int bar_height = 6;
      if (future_face_mode_ == FutureFaceMode::kSpeaking) {
        bar_height = 6 + ((future_face_frame_ + i * 3) % 7) * 2;
      } else if (future_face_mode_ == FutureFaceMode::kHappy) {
        bar_height = i == 1 ? 11 + bounce : 7 + bounce / 2;
      } else if (future_face_mode_ == FutureFaceMode::kSleep) {
        bar_height = 3;
      } else if (future_face_mode_ == FutureFaceMode::kThinking) {
        bar_height = i == (future_face_frame_ / 3) % 3 ? 9 : 5;
      }
      lv_obj_set_style_bg_color(face.mouth[i], mouth_color, 0);
      lv_obj_set_size(face.mouth[i], root_width / 13, bar_height);
      lv_obj_set_pos(face.mouth[i], root_width / 2 - root_width / 13 - 8 +
                                        i * (root_width / 13 + 8),
                     mouth_base_y - bar_height / 2);
    }
  }
public:
  // fwsim: harness accessor (not in firmware)
  CheekoOs *fwsim_os() { return cheeko_os_.get(); }
};
